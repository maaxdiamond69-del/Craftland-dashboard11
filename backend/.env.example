# Copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql+psycopg2://dash:CHANGE_ME@localhost:5432/botdash
# 64+ random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Fernet key for encrypting Telegram tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
ADMIN_USER=admin
# If left empty a random password is generated and printed once on first start
ADMIN_PASSWORD=
# Set to true when served over HTTPS (recommended, always true in production)
COOKIE_SECURE=false
LOG_RETENTION_DAYS=30
OFFLINE_AFTER_SECONDS=90
